<?xml version="1.0" encoding="UTF-8" ?>
<!--
Fast DDS profile: UDP transport only, no shared memory.

The SONIC deploy (g1_deploy_onnx_ref, `docker/run-ros2-dev.sh`, started with
`--ipc host`) and the episode exporter (`wbc-marin`, private IPC namespace)
run in different containers. Fast DDS discovers peers over UDP but then
moves the data onto its shared-memory transport, which cannot cross IPC
namespaces: the subscriber sees "Publisher count: 1" and never gets a
message. Pointing FASTRTPS_DEFAULT_PROFILES_FILE at this file on the
exporter side forces UDP for everything. Set by ~/wbc-marin-exec.sh.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
